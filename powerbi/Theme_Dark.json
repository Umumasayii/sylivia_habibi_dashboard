{
  "name": "KLTS Dark",
  "dataColors": [
    "#3987e5",
    "#d95926",
    "#199e70",
    "#c98500",
    "#d55181",
    "#0ca30c",
    "#9085e9",
    "#e66767"
  ],
  "background": "#101828",
  "foreground": "#E9EEF6",
  "tableAccent": "#2CC4B2",
  "good": "#3FD17A",
  "neutral": "#EDA100",
  "bad": "#F07171",
  "maximum": "#7FB2F0",
  "center": "#1A263D",
  "minimum": "#F07171",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#E9EEF6"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#E9EEF6"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#E9EEF6"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#AAB6C9"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#101828"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#22304A"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#E9EEF6"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#AAB6C9"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1F2B41"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#AAB6C9"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1F2B41"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#AAB6C9"
              }
            },
            "position": "Top"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#080D19"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#080D19"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#22304A"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#22304A"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#22304A"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1A263D"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E9EEF6"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#101828"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E9EEF6"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#141E31"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#E9EEF6"
              }
            },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#AAB6C9"
              }
            }
          }
        ]
      }
    }
  }
}